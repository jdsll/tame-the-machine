# Resend — sign up at resend.com, verify tamethemachine.com domain, create API key
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=assessment@tamethemachine.com

# Google Sheets — service account credentials from GCP project aios-488915
GOOGLE_SHEETS_CLIENT_EMAIL=...@...iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Nurture sequence
# CRON_SECRET: Vercel sends it as a Bearer token to cron routes; generate with `openssl rand -hex 32`
CRON_SECRET=...
# UNSUBSCRIBE_SECRET: HMAC key for unsubscribe links; generate with `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=...
# Optional: nurture from/reply-to overrides. From must use the verified Resend domain
# (send.tamethemachine.com); replies go to the real inbox.
# NURTURE_FROM_EMAIL=Jeff Restel <jeff@send.tamethemachine.com>
# NURTURE_REPLY_TO=jeff@tamethemachine.com
