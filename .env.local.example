# Resend — sign up at resend.com, verify tamethemachine.com domain, create API key
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=assessment@tamethemachine.com

# Google Sheets — service account credentials from GCP project aios-488915
GOOGLE_SHEETS_CLIENT_EMAIL=...@...iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Nurture sequence
# CRON_SECRET: Vercel sends it as a Bearer token to cron routes; generate with `openssl rand -hex 32`
CRON_SECRET=...
# UNSUBSCRIBE_SECRET: HMAC key for unsubscribe links; generate with `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=...
# Optional: nurture from/reply-to overrides. From must use the verified Resend domain
# (send.tamethemachine.com); replies go to the real inbox.
# NURTURE_FROM_EMAIL=Jeff Restel <jeff@send.tamethemachine.com>
# NURTURE_REPLY_TO=jeff@tamethemachine.com

# Front Desk AI landing page (/receptionist)
# These are NEXT_PUBLIC_* — inlined into the client bundle at build time, so they
# are publicly visible. Never put secret keys here; use Payment Links, not API keys.
# NEXT_PUBLIC_CALENDLY_URL: booking link for demo CTAs. Falls back to the audit
# Calendly link (https://calendly.com/jeff-tamethemachine/audit) if unset.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jeff-tamethemachine/audit
# NEXT_PUBLIC_DEMO_LINE_NUMBER: public demo phone number in E.164, e.g. +15551234567.
# If unset, the page shows "Demo line launching this week" and points to Calendly.
NEXT_PUBLIC_DEMO_LINE_NUMBER=+15551234567
# NEXT_PUBLIC_STRIPE_LINK_STARTER: Stripe Payment Link for the $199 Starter plan.
# If unset, the Starter button becomes "Join the waitlist" and links to Calendly.
NEXT_PUBLIC_STRIPE_LINK_STARTER=https://buy.stripe.com/your_starter_link
